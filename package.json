{
  "name": "private-packagist-api",
  "version": "1.0.0",
  "description": "TypeScript client for the Private Packagist API, with request signing that matches the official PHP client byte for byte",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && npm run build && node --test --experimental-strip-types \"test/*.test.ts\"",
    "vectors": "php scripts/php-vectors.php ../private-packagist-api-client test/fixtures",
    "types": "node scripts/gen-types.mjs openapi.json src/schema.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "private packagist",
    "packagist",
    "composer",
    "php",
    "api",
    "client",
    "hmac",
    "typescript"
  ],
  "author": "Alexandr Khrustalev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanderSaxBuilds/private-packagist-ts.git"
  },
  "bugs": {
    "url": "https://github.com/SanderSaxBuilds/private-packagist-ts/issues"
  },
  "homepage": "https://github.com/SanderSaxBuilds/private-packagist-ts#readme",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3"
  }
}
